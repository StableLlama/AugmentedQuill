{
  "name": "augmentedquill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:exports": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:bundle-budget": "node scripts/checkBundleBudget.mjs",
    "build": "npm run typecheck && vite build && npm run check:bundle-budget",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fixture": "cd tests/e2e/fixture && vite --port 5199",
    "test:e2e:docs": "playwright test --config=playwright.docs.config.ts",
    "test:accessibility": "vitest run features/layout/ConfirmDialog.test.tsx features/chat/ToolCallLimitDialog.test.tsx features/story/MetadataEditorDialog.test.tsx features/settings/settings/SettingsMachine.test.tsx",
    "generate:types": "node scripts/generateTypes.mjs",
    "check:generated-types": "node scripts/generateTypes.mjs && git diff --exit-code types/api.generated.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@google/genai": "^2.17.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@testing-library/dom": "^10.4.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "codemirror": "^6.0.2",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.13",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "marked": "18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "turndown": "7.2.4",
    "uuid": "^14.0.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "@typescript/native7": "npm:typescript@^7.0.2",
    "typescript": "npm:typescript@~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}

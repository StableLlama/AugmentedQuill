{
  "name": "augmentedquill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:exports": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:bundle-budget": "node scripts/checkBundleBudget.mjs",
    "build": "npm run typecheck && vite build && npm run check:bundle-budget",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fixture": "cd tests/e2e/fixture && vite --port 5199",
    "test:e2e:docs": "playwright test --config=playwright.docs.config.ts",
    "test:accessibility": "vitest run index.css.test.ts features/layout/ConfirmDialog.test.tsx features/chat/ToolCallLimitDialog.test.tsx features/story/MetadataEditorDialog.test.tsx features/settings/settings/SettingsMachine.test.tsx",
    "generate:types": "node scripts/generateTypes.mjs",
    "check:generated-types": "node scripts/generateTypes.mjs && git diff --exit-code types/api.generated.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@google/genai": "^3.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "codemirror": "^6.0.2",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.17",
    "i18next": "^27.0.0",
    "lucide-react": "^1.70.0",
    "marked": "18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "turndown": "7.2.5",
    "uuid": "^14.0.3",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "protobufjs": "^7.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native7": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:typescript@~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
